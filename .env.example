# ============================================================================
# ENVIRONMENT CONFIGURATION - Copy to .env.local for development
# ============================================================================

# --- DATABASE ---
MYSQL_ROOT_PASSWORD=changeme_in_production
MYSQL_DATABASE=librairie_numérique

# --- JWT SECRETS (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production

# --- PORT CONFIGURATION ---
BACKEND_PORT=3000
FRONTEND_PORT=3000

# --- NODE ENVIRONMENT ---
NODE_ENV=production
