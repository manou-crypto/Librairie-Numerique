# --- URL DU BACKEND (Railway) ---
# URL publique du service NestJS sur Railway
# Exemple : https://backend-nestjs-production-xxxx.up.railway.app
NEXT_PUBLIC_API_URL=https://TON-BACKEND.railway.app/api

# --- URL DU FRONTEND ---
# URL publique du frontend Vercel (disponible après déploiement)
NEXT_PUBLIC_SITE_URL=https://TON-PROJET.vercel.app

# --- CLOUDINARY (images produits) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=gbb7huxa
NEXT_PUBLIC_CLOUDINARY_API_KEY=959631882842267

# --- REWRITE INTERNE (serveur Next.js → backend) ---
# Utilisé par next.config.mjs pour les rewrites /api/*
# DOIT pointer vers le même backend que NEXT_PUBLIC_API_URL (sans /api à la fin)
BACKEND_URL=https://TON-BACKEND.railway.app
